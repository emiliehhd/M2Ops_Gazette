POSTGRES_USER=gazette
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gazette
# Port de l interface Airflow sur votre machine (8080 par defaut)
# AIRFLOW_PORT=8081
# Alerte des contrôles de qualité : adresse du webhook du canal Discord de l'équipe.
# SECRET : quiconque la connaît peut écrire dans le canal. Ne la commitez jamais (.env est ignoré par Git).
DISCORD_WEBHOOK_URL=
# Facultatif : seuil du taux de rejet par source (0,8 par défaut). Le baisser provoque l'alerte à la demande.
# GAZETTE_SEUIL_TAUX_REJET=0.05
